#!/bin/sh
# Command line entry point inside Labyrinth Cleaner.app. Symlinked as `devclean`.
self=$(/usr/bin/readlink -f "$0")
dir=$(dirname "$self")
py="$dir/../python/bin/python3"
if [ ! -x "$py" ]; then
    echo "Labyrinth Cleaner's Python is missing. Reinstall the app." >&2
    exit 1
fi
LABYRINTH_TRASH_HELPER=$(cd "$dir/../../MacOS" && pwd -P)/labyrinth-trash
export LABYRINTH_TRASH_HELPER
exec "$py" -E -s -X utf8 "$dir/devclean" "$@"
